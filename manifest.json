{
  "manifest_version": 3,
  "name": "WaveDrop",
  "version": "2.1.0",
  "description": "A neon macOS-inspired YouTube companion — floating panel, MP3/MP4 via a local yt-dlp bridge, and automatic hand-off into an Apple Music playlist.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://music.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/worker.js"
  },
  "action": {
    "default_title": "WaveDrop",
    "default_popup": "popup/popup.html"
  }
}
